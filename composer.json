{
    "name": "shift-management/service",
    "description": "REST API for registering employee shifts.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "php": "~8.4.1",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/type-info": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/dom-crawler": "7.4.*",
        "symfony/options-resolver": "7.4.*",
        "symfony/process": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config compose.yaml compose.test.yaml",
            "@php bin/console doctrine:schema:validate --skip-sync",
            "@lint",
            "@analyse"
        ],
        "analyse": [
            "@php bin/console --env=test cache:warmup",
            "phpstan analyse --memory-limit=512M"
        ],
        "lint": [
            "phpcs",
            "@style:check"
        ],
        "style:check": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:functional": "phpunit --testsuite Functional",
        "verify": [
            "@check",
            "@test"
        ]
    }
}
