# Copy to .env.local for local overrides. SQLite data lives in var/data/.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=local-development-only-change-before-deployment
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/shifts.sqlite"
# Selects the database or null notification adapter through DI.
SHIFT_NOTIFICATIONS_ENABLED=true
# Successfully validated holiday data lifetime, in seconds.
HOLIDAY_CACHE_TTL=86400
# Keep the trailing slash so relative resource paths preserve /api/v4/.
NAGER_API_BASE_URI=https://nagerholidays.com/api/v4/
# Compose reads the host port from .env or the shell, not .env.local.
HTTP_PORT=8080
SQLITE_BUSY_TIMEOUT_MS=5000
